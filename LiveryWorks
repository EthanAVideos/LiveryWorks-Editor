# Key obfuscation (must match system_encryption.py)
def deobfuscate_key(obfuscated):
    xor_result = base64.b64decode(obfuscated)
    xor_pattern = b'LW2024'
    b64_encoded = bytes([xor_result[i] ^ xor_pattern[i % len(xor_pattern)]
                        for i in range(len(xor_result))])
    reversed_key = base64.b64decode(b64_encoded)
    return reversed_key[::-1]

